// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PASTOR
  STAFF
  TREASURER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum DonationType {
  DONATION
  OTHERS
}

enum VoidRequestEntity {
  DONATION
  SERVICE_INCOME
  EXPENSE
}

enum VoidRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  phoneNumber  String?
  address      String?
  birthdate    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actionLogs   ActionLog[] @relation("ActionLogActor")
  voidRequestsRequested VoidRequest[] @relation("VoidRequestRequester")
  voidRequestsReviewed  VoidRequest[] @relation("VoidRequestReviewer")
}

/// Staff/treasurer void proposals; admin must approve before financial rows are soft-deleted.
model VoidRequest {
  id             String            @id @default(cuid())
  entity         VoidRequestEntity
  entityId       String
  requestedById  String
  reason         String            @db.VarChar(500)
  status         VoidRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  declineNote    String?           @db.VarChar(500)

  requestedBy User  @relation("VoidRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("VoidRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entity, entityId])
}

model FamilyGroup {
  id          String   @id @default(cuid())
  familyName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     Member[]
}

model Member {
  id             String   @id @default(cuid())
  firstName     String
  lastName      String
  gender        Gender?
  birthdate     DateTime?
  contactNumber String?
  address       String?

  familyGroupId String?
  familyGroup   FamilyGroup? @relation(fields: [familyGroupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
  donations  Donation[]

  @@index([lastName])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Treat as the "service" date for attendance.
  date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
}

model Attendance {
  id       String @id @default(cuid())
  memberId String
  eventId  String
  // Service date (derived from event in the UI).
  date     DateTime
  status   AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@unique([memberId, eventId])
  @@index([eventId, date])
}

model Donation {
  id       String  @id @default(cuid())
  memberId String
  amount   Decimal @db.Decimal(10, 2)
  type     DonationType
  date     DateTime
  isDeleted Boolean @default(false)
  voidReason String?
  voidedAt DateTime?
  voidedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([type, date])
}

model ServiceIncome {
  id          String   @id @default(cuid())
  serviceDate DateTime @unique
  amount      Decimal  @db.Decimal(10, 2)
  isDeleted Boolean @default(false)
  voidReason String?
  voidedAt DateTime?
  voidedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceDate])
}

model Expense {
  id     String @id @default(cuid())
  type   String
  claimedBy String @default("Unknown")
  receivedBy String @default("Unknown")
  date   DateTime
  amount Decimal @db.Decimal(10, 2)
  isDeleted Boolean @default(false)
  voidReason String?
  voidedAt DateTime?
  voidedBy String?
  // Snapshot values used when amount is derived from monthly percentage allocation.
  allocationPercentUsed Decimal? @db.Decimal(5, 2)
  serviceIncomeMonthTotalUsed Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, date])
}

model ExpenseType {
  id   String @id @default(cuid())
  name String @unique
  // Admin-controlled percentage allocation of monthly Service Income.
  allocationPercent Decimal @default(0) @db.Decimal(5, 2)
  // Only types marked true participate in the required 100% allocation check.
  isAllocatedFromServiceIncome Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id        String   @id @default(cuid())
  userId    String?
  actionType String?
  module    String?
  oldValue  Json?
  newValue  Json?
  timestamp DateTime @default(now())
  actorId   String?
  actorName String
  actorRole Role
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActionLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([module, timestamp])
  @@index([actorRole, createdAt])
  @@index([entity, createdAt])
}
